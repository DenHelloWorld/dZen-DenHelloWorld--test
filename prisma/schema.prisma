generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model orders {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  description String?    @db.Text
  created_at  DateTime   @default(now()) @db.Timestamp(0)
  products    products[]
}

model prices {
  id         Int      @id @default(autoincrement())
  product_id Int
  value      Decimal  @db.Decimal(12, 2)
  symbol     String   @db.VarChar(3)
  is_default Boolean  @default(false)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_prices_product")

  @@index([product_id], map: "idx_prices_product")
}

model products {
  id              Int       @id @default(autoincrement())
  order_id        Int
  serial_number   String?   @db.VarChar(50)
  is_new          Boolean   @default(true)
  photo           String?   @db.VarChar(255)
  title           String    @db.VarChar(255)
  type            String    @db.VarChar(100)
  specification   String?   @db.VarChar(255)
  guarantee_start DateTime? @db.Date
  guarantee_end   DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamp(0)
  prices          prices[]
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_products_order")

  @@index([order_id], map: "idx_products_order")
  @@index([type], map: "idx_products_type")
}

model users {
  id            Int      @id @default(autoincrement())
  username      String   @unique(map: "uq_users_username") @db.VarChar(50)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now()) @db.Timestamp(0)
}
